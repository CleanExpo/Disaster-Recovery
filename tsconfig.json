{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false, // Phased migration. Full flip deferred — produces 227 errors (primarily strictNullChecks + noImplicitAny). Individual flags enabled below.
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ]
    },
    // Strict mode flags - enabling gradually
    // Individual strict flags (phased enablement). Each requires its own fix wave.
    "noImplicitAny": false,               // Phase 3 (deferred — ~540 `any` annotations in src/)
    "strictNullChecks": false,            // Phase 2 (deferred — ~200 call-site fixes expected)
    "strictFunctionTypes": true,          // Phase 1 — ENABLED
    "strictBindCallApply": true,          // Phase 1 — ENABLED
    "strictPropertyInitialization": false,// Phase 3 — requires strictNullChecks
    "noImplicitThis": true,               // Phase 1 — ENABLED
    "alwaysStrict": true,                 // Phase 1 — ENABLED
    "useUnknownInCatchVariables": true,   // Phase 1.5 — ENABLED 2026-04-24 (Foundation Sprint Day 4). 6 catch-block error.message accesses narrowed.
    
    // Additional type checking flags
    "noUnusedLocals": false, // Phase 4: Enable after main strict flags
    "noUnusedParameters": false, // Phase 4: Enable after main strict flags
    "noImplicitReturns": true, // ENABLED: Functions must return values
    "noFallthroughCasesInSwitch": true, // ENABLED: Switch case safety
    "allowUnreachableCode": false, // Phase 1: ENABLED - Errors on unreachable code
    "allowUnusedLabels": false, // Phase 1: ENABLED - Errors on unused labels
    
    // New helpful flags for gradual migration
    "noUncheckedIndexedAccess": false, // Phase 3: Adds undefined to index signatures
    "exactOptionalPropertyTypes": false, // Phase 4: Stricter optional property handling
    "noPropertyAccessFromIndexSignature": false // Phase 4: Requires bracket notation for index signatures
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "scripts",
    "test-results",
    "audio-system/**",
    "audio-system.backup/**",
    "bots/**",
    "bots.backup/**",
    "cli/**",
    "CRM_Reference/**",
    "docker/**",
    "health-check/**",
    "NRP-CRM/**",
    "Portals/**",
    "lib/**",
    "components/**",
    "src/crm/**",
    "src/lib/validation.ts",
    "src/lib/notifications/sms-service.ts",
    "src/lib/services/mock/**",
    "src/components/partners/AffiliateSignup.tsx",
    "src/components/layout/R6Header.tsx",
    "src/hooks/useFormValidation.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tests/**"
  ]
}
