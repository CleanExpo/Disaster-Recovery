{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true, // Fully enabled — Foundation Sprint POLISH PR 1
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/types/*": ["./src/types/*"]
    },
    // Strict mode flags - all enabled (kept explicit for documentation)
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,

    // Additional type checking flags
    "noUnusedLocals": false, // Phase 4: Enable after main strict flags. C14 enablement attempted 2026-04-30 — surfaces 1,564 errors (mostly unused imports). Tracked as separate cleanup epic; do NOT enable in piecemeal commits.
    "noUnusedParameters": false, // Phase 4: Enable after main strict flags
    "noImplicitReturns": true, // ENABLED: Functions must return values
    "noFallthroughCasesInSwitch": true, // ENABLED: Switch case safety
    "allowUnreachableCode": false, // Phase 1: ENABLED - Errors on unreachable code
    "allowUnusedLabels": false, // Phase 1: ENABLED - Errors on unused labels

    // New helpful flags for gradual migration
    "noUncheckedIndexedAccess": false, // Phase 3: Adds undefined to index signatures
    "exactOptionalPropertyTypes": false, // Phase 4: Stricter optional property handling
    "noPropertyAccessFromIndexSignature": false // Phase 4: Requires bracket notation for index signatures
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "scripts",
    "test-results",
    "audio-system/**",
    "audio-system.backup/**",
    "bots/**",
    "bots.backup/**",
    "cli/**",
    "CRM_Reference/**",
    "docker/**",
    "health-check/**",
    "NRP-CRM/**",
    "Portals/**",
    "lib/**",
    "components/**",
    "src/crm/**",
    "src/lib/validation.ts",
    "src/lib/notifications/sms-service.ts",
    "src/lib/services/mock/**",
    "src/components/partners/AffiliateSignup.tsx",
    "src/components/layout/R6Header.tsx",
    "src/hooks/useFormValidation.ts",
    "app/portal/training/modules/day-2/**",
    "app/portal/training/modules/day-3/**",
    "app/portal/training/modules/day-4/**",
    "app/portal/training/modules/day-5/**",
    "app/portal/training/modules/day-6/**",
    "app/portal/training/modules/day-7/**",
    "app/portal/training/modules/day-8/**",
    "src/agents/ui-design/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tests/**"
  ]
}
