# Database Configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/disaster_recovery
DB_USER=admin
DB_PASSWORD=password
DB_NAME=disaster_recovery
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# Application Configuration
NODE_ENV=development
APP_VERSION=1.0.0
APP_PORT=3000

# Authentication Providers (configure as needed)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Stripe Configuration (payments)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NRPG Callout Pricing (GST flags)
NRPG_CALLOUT_TOTAL_GST_INCLUSIVE=true
NRPG_CALLOUT_PLATFORM_FEE_GST_INCLUSIVE=true
NRPG_CALLOUT_CONTRACTOR_ENTITLEMENT_GST_INCLUSIVE=true

# Email Configuration (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@disaster-recovery.local

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring and Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true
SENTRY_DSN=

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=/uploads
MAX_FILE_SIZE=52428800

# Feature Flags
ENABLE_READ_RECEIPTS=true
ENABLE_TYPING_INDICATORS=true
ENABLE_PRESENCE=true
ENABLE_REACTIONS=true
ENABLE_THREADS=true
ENABLE_MESSAGE_EDITING=true
ENABLE_ENCRYPTION=false

# Performance Configuration
CACHE_TTL=3600
MESSAGE_BATCH_SIZE=50
PAGINATION_LIMIT=20

# Resilience Configuration
ENABLE_GRACEFUL_DEGRADATION=true
ENABLE_AUTO_HEALING=true
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_THRESHOLD=5

# pgAdmin Configuration
PGADMIN_EMAIL=admin@disaster-recovery.local
PGADMIN_PASSWORD=admin

# AI/ML Configuration
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
AI_MODEL_NAME=gpt2
AI_CACHE_SIZE=1000
AI_CACHE_TTL=3600000
AI_RATE_LIMIT=60
AI_WORKER_CONCURRENCY=5
AI_QUEUE_NAME=ai-processing

# Redis Configuration for AI
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
