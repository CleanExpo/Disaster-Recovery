# ===================================================================
# DISASTER RECOVERY - NRPG PLATFORM
# Environment Variables Configuration
# ===================================================================
#
# SECURITY NOTICE:
# - This file contains EXAMPLE values only
# - NEVER commit actual secrets to version control
# - Copy this file to .env.local and replace with real values
# - All sensitive variables should be marked "Encrypted" in Vercel
# - Rotate secrets regularly (recommended: every 90 days)
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Replace all placeholder values with actual credentials
# 3. Verify .env.local is in .gitignore
# 4. For Vercel deployment, see docs/VERCEL_ENV_SETUP.md
#
# ===================================================================

# -------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -------------------------------------------------------------------

# Base URL for the application (no trailing slash)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application environment
# Values: development | staging | production
NODE_ENV=development

# Application version (semantic versioning)
APP_VERSION=1.0.0

# Application port (default: 3000)
APP_PORT=3000

# Enable debug mode (set to "false" in production)
DEBUG=false

# -------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -------------------------------------------------------------------

# Primary database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Production: Use connection pooling (e.g., PgBouncer, Supabase pooler)
DATABASE_URL=postgresql://admin:password@localhost:5432/disaster_recovery?schema=public

# Direct database URL (bypasses connection pooler)
# Required for migrations and schema operations
# Should point directly to database, not pooler
DIRECT_URL=postgresql://admin:password@localhost:5432/disaster_recovery?schema=public

# Individual database credentials (for manual connection)
DB_USER=admin
DB_PASSWORD=password
DB_NAME=disaster_recovery
DB_PORT=5432
DB_HOST=localhost

# Database pool settings (optional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=10000

# -------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -------------------------------------------------------------------

# NextAuth.js Configuration
# NextAuth URL (must match NEXT_PUBLIC_SITE_URL)
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (generate with: openssl rand -base64 32)
# CRITICAL: Use a strong, random secret in production
# Mark as "Encrypted" in Vercel
NEXTAUTH_SECRET=your-nextauth-secret-here-change-in-production

# JWT Secret for token signing (generate with: openssl rand -base64 32)
# Should be different from NEXTAUTH_SECRET
# Mark as "Encrypted" in Vercel
JWT_SECRET=your-jwt-secret-here-change-in-production

# Session configuration
# SESSION_MAX_AGE=2592000  # 30 days in seconds
# SESSION_UPDATE_AGE=86400  # 1 day in seconds

# OAuth Providers (configure as needed)
# GitHub OAuth
# Get from: https://github.com/settings/developers
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_ID=your_google_oauth_client_id
GOOGLE_SECRET=your_google_oauth_client_secret

# -------------------------------------------------------------------
# PAYMENT PROCESSING (Stripe)
# -------------------------------------------------------------------

# Stripe Secret Key (starts with sk_test_ or sk_live_)
# Get from: https://dashboard.stripe.com/apikeys
# Mark as "Encrypted" in Vercel
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (starts with pk_test_ or pk_live_)
# Safe to expose to client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (starts with whsec_)
# Get from: https://dashboard.stripe.com/webhooks
# Different for each environment
# Mark as "Encrypted" in Vercel
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe API Version (optional)
# STRIPE_API_VERSION=2023-10-16

# Real-Time Add-On Subscription Pricing (Phase 5)
# Create these prices in Stripe Dashboard under Products
# Product: "Real-Time Job Coordination Add-On"
# Get Price IDs from: https://dashboard.stripe.com/products
STRIPE_REALTIME_BASIC_PRICE_ID=price_realtime_basic_xxx
STRIPE_REALTIME_PRO_PRICE_ID=price_realtime_pro_xxx
STRIPE_REALTIME_ENTERPRISE_PRICE_ID=price_realtime_enterprise_xxx

# Stripe Webhook Secret for Real-Time Add-On (separate webhook endpoint)
# Create a new webhook at: https://dashboard.stripe.com/webhooks
# Endpoint: /api/webhooks/stripe/realtime
# Events: checkout.session.completed, customer.subscription.*, invoice.*
# Mark as "Encrypted" in Vercel
STRIPE_REALTIME_WEBHOOK_SECRET=whsec_your_realtime_webhook_secret_here

# -------------------------------------------------------------------
# NRPG BUSINESS CONFIGURATION
# -------------------------------------------------------------------

# NRPG Callout Pricing (GST/Tax Configuration)
# Set to true if prices include GST, false if GST is added on top
NRPG_CALLOUT_TOTAL_GST_INCLUSIVE=true
NRPG_CALLOUT_PLATFORM_FEE_GST_INCLUSIVE=true
NRPG_CALLOUT_CONTRACTOR_ENTITLEMENT_GST_INCLUSIVE=true

# GST Rate (as decimal, e.g., 0.10 for 10%)
# NRPG_GST_RATE=0.10

# Platform fee percentage
# NRPG_PLATFORM_FEE_PERCENT=15

# -------------------------------------------------------------------
# EMAIL SERVICE
# -------------------------------------------------------------------

# Email provider: sendgrid | ses | smtp
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration
# Get API key from: https://app.sendgrid.com/settings/api_keys
# Mark as "Encrypted" in Vercel
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Email addresses
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Disaster Recovery NRPG

# SMTP Configuration (if using custom SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_SECURE=true

# AWS SES Configuration (alternative to SendGrid)
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key

# -------------------------------------------------------------------
# CONTENT MANAGEMENT SYSTEM (Sanity CMS)
# -------------------------------------------------------------------

# Sanity Project ID
# Get from: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Sanity Dataset (usually "production" or "development")
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token (for write operations)
# Get from: https://sanity.io/manage/project/YOUR_PROJECT_ID/api
# Mark as "Encrypted" in Vercel
SANITY_API_TOKEN=skYourSanityApiTokenHere

# Sanity API Version
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Webhook Secret (for revalidation)
# Generate with: openssl rand -base64 32
# Mark as "Encrypted" in Vercel
SANITY_REVALIDATE_SECRET=your_sanity_webhook_secret_here

# Enable Sanity Studio in production (true | false)
NEXT_PUBLIC_SANITY_STUDIO_ENABLED=false

# -------------------------------------------------------------------
# SEARCH SERVICE (Algolia)
# -------------------------------------------------------------------

# Algolia Application ID
# Get from: https://dashboard.algolia.com/account/api-keys
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id

# Algolia Search API Key (public, read-only)
# Safe to expose to client
NEXT_PUBLIC_ALGOLIA_API_KEY=your_algolia_search_api_key

# Algolia Admin API Key (for indexing operations)
# Get from: https://dashboard.algolia.com/account/api-keys
# Mark as "Encrypted" in Vercel
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_api_key

# Algolia Index Names (customize for your application)
ALGOLIA_INDEX_RESOURCES=resources
ALGOLIA_INDEX_GUIDES=guides
ALGOLIA_INDEX_USERS=users

# -------------------------------------------------------------------
# ANALYTICS & MONITORING
# -------------------------------------------------------------------

# Google Analytics 4 (GA4) Configuration
# Get Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
# REQUIRED for analytics tracking
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (GTM) ID (Optional)
# Get from: https://tagmanager.google.com/
# Format: GTM-XXXXXXX
# Only needed if using GTM for tag management
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Sentry Configuration (Error Tracking)
# Get DSN from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ORG=your_org_slug
SENTRY_PROJECT=your_project_slug
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true

# PostHog Configuration (Product Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -------------------------------------------------------------------
# SECURITY & RATE LIMITING
# -------------------------------------------------------------------

# hCaptcha Configuration (Bot Protection)
# Get from: https://dashboard.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

# reCAPTCHA v3 (Alternative to hCaptcha)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# -------------------------------------------------------------------
# REDIS CACHE & SESSION STORAGE
# -------------------------------------------------------------------

# Redis connection URL
# Development: redis://localhost:6379
# Production: Use managed Redis (Upstash, AWS ElastiCache, etc.)
REDIS_URL=redis://localhost:6379

# Individual Redis configuration (for manual connection)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Upstash Redis (recommended for serverless/Vercel)
# REQUIRED FOR RATE LIMITING - Get from: https://console.upstash.com/
# Mark as "Encrypted" in Vercel
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Redis configuration
REDIS_TLS=false
REDIS_MAX_RETRIES=3

# -------------------------------------------------------------------
# FILE STORAGE & CDN
# -------------------------------------------------------------------

# Storage type: local | s3 | cloudinary
STORAGE_TYPE=local
STORAGE_PATH=/uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# AWS S3 Configuration (for production file uploads)
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_S3_CDN_URL=https://cdn.your-domain.com

# Cloudinary Configuration (Alternative to S3)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------------
# AI & MACHINE LEARNING
# -------------------------------------------------------------------

# Google Gemini API (Video & Image Generation)
# Get from: https://makersuite.google.com/app/apikey
# Mark as "Encrypted" in Vercel
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API (Alternative AI models)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
AI_MODEL_NAME=gpt2

# AI Processing Configuration
AI_CACHE_SIZE=1000
AI_CACHE_TTL=3600000
AI_RATE_LIMIT=60
AI_WORKER_CONCURRENCY=5
AI_QUEUE_NAME=ai-processing

# OpenAI API (if using GPT models)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# -------------------------------------------------------------------
# GOOGLE MAPS PLATFORM (Phase 3: Client Live View)
# -------------------------------------------------------------------

# Google Maps JavaScript API Key (client-side)
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
# Required APIs: Maps JavaScript API, Places API, Directions API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Server Key (for Directions API calls)
# Separate key with IP/referrer restrictions for server-side use
# Mark as "Encrypted" in Vercel
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# -------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS
# -------------------------------------------------------------------

# Slack Notifications (for alerts and monitoring)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_CHANNEL=#alerts

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Discord Webhook (for alerts)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# -------------------------------------------------------------------
# FEATURE FLAGS
# -------------------------------------------------------------------

# Real-time features
ENABLE_READ_RECEIPTS=true
ENABLE_TYPING_INDICATORS=true
ENABLE_PRESENCE=true
ENABLE_REACTIONS=true
ENABLE_THREADS=true
ENABLE_MESSAGE_EDITING=true
ENABLE_ENCRYPTION=false

# Beta features (true | false)
# ENABLE_BETA_FEATURES=false

# Maintenance mode (true | false)
# MAINTENANCE_MODE=false

# Additional feature flags
# FEATURE_FLAG_NEW_DASHBOARD=false
# FEATURE_FLAG_AI_RECOMMENDATIONS=false
# FEATURE_FLAG_ADVANCED_ANALYTICS=false

# -------------------------------------------------------------------
# PERFORMANCE CONFIGURATION
# -------------------------------------------------------------------

# Cache configuration
CACHE_TTL=3600  # 1 hour in seconds

# Pagination & batching
MESSAGE_BATCH_SIZE=50
PAGINATION_LIMIT=20

# -------------------------------------------------------------------
# RESILIENCE & RELIABILITY
# -------------------------------------------------------------------

# Graceful degradation & auto-healing
ENABLE_GRACEFUL_DEGRADATION=true
ENABLE_AUTO_HEALING=true

# Circuit breaker configuration
CIRCUIT_BREAKER_TIMEOUT=60000  # 60 seconds
CIRCUIT_BREAKER_THRESHOLD=5

# -------------------------------------------------------------------
# DEVELOPMENT & TESTING
# -------------------------------------------------------------------

# Use mock database (for testing without real database)
USE_MOCK_DB=false

# Enable test mode (bypasses certain validations)
# TEST_MODE=false

# Seed database on startup
# AUTO_SEED_DATABASE=false

# Enable verbose logging
# VERBOSE_LOGGING=false

# Skip email sending in development
# SKIP_EMAIL_SENDING=true

# -------------------------------------------------------------------
# PGADMIN (Database Management - Development Only)
# -------------------------------------------------------------------

# pgAdmin Configuration (for local development)
# WARNING: Do NOT use these credentials in production
PGADMIN_EMAIL=admin@disaster-recovery.local
PGADMIN_PASSWORD=admin

# -------------------------------------------------------------------
# INFRASTRUCTURE & DEPLOYMENT
# -------------------------------------------------------------------

# Vercel Configuration (auto-populated)
# VERCEL_URL=auto-generated-by-vercel
# VERCEL_ENV=development | preview | production

# Docker Configuration
# DOCKER_BUILDKIT=1

# Health check endpoint path
HEALTH_CHECK_PATH=/api/health

# -------------------------------------------------------------------
# COMPLIANCE & LEGAL
# -------------------------------------------------------------------

# Enable GDPR mode (enhanced privacy controls)
GDPR_MODE=true

# Cookie consent banner
ENABLE_COOKIE_CONSENT=true

# Data retention period (in days)
DATA_RETENTION_DAYS=365

# -------------------------------------------------------------------
# NOTES & DOCUMENTATION
# -------------------------------------------------------------------
#
# SECRET ROTATION SCHEDULE:
# - Database credentials: Every 90 days
# - API keys (Stripe, SendGrid, Gemini): Every 90 days
# - JWT secrets: Every 180 days
# - Session secrets: Every 180 days
# - OAuth secrets: Every 180 days
#
# SECURITY BEST PRACTICES:
# - Use strong, randomly generated secrets (32+ characters)
# - Never share secrets via email or chat
# - Use environment-specific secrets (dev ≠ staging ≠ production)
# - Store production secrets in secure vault (1Password, AWS Secrets Manager)
# - Enable MFA on all service provider accounts
# - Regularly audit access logs
# - Use principle of least privilege for API keys
#
# VERCEL DEPLOYMENT:
# - See docs/VERCEL_ENV_SETUP.md for detailed setup instructions
# - Mark all *_SECRET_* and *_API_KEY variables as "Encrypted"
# - Use different Stripe/SendGrid keys for preview vs production
# - Test webhook endpoints after each deployment
# - Set up environment-specific variables correctly
#
# REQUIRED VARIABLES (minimum for basic functionality):
# - DATABASE_URL
# - NEXTAUTH_URL
# - NEXTAUTH_SECRET
# - NEXT_PUBLIC_SITE_URL
#
# REQUIRED FOR PAYMENTS:
# - STRIPE_SECRET_KEY
# - STRIPE_PUBLISHABLE_KEY
# - STRIPE_WEBHOOK_SECRET
#
# REQUIRED FOR EMAIL:
# - EMAIL_FROM
# - SENDGRID_API_KEY (or SMTP credentials)
#
# REQUIRED FOR CMS:
# - NEXT_PUBLIC_SANITY_PROJECT_ID
# - NEXT_PUBLIC_SANITY_DATASET
# - SANITY_API_TOKEN
#
# REQUIRED FOR SEARCH:
# - NEXT_PUBLIC_ALGOLIA_APP_ID
# - NEXT_PUBLIC_ALGOLIA_API_KEY
# - ALGOLIA_ADMIN_API_KEY
#
# REQUIRED FOR CAPTCHA:
# - NEXT_PUBLIC_HCAPTCHA_SITE_KEY
# - HCAPTCHA_SECRET_KEY
#
# ===================================================================
