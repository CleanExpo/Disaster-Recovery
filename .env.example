# ========================================
# NRP Disaster Recovery Platform
# Environment Configuration Template
# ========================================

# ⚠️ CRITICAL: DO NOT MODIFY THESE DOMAINS WITHOUT APPROVAL
# Production: https://disaster-recovery-seven-virid.vercel.app
# Staging: https://disaster-recovery-staging.vercel.app
# NEVER use disasterrecovery.com.au in environment variables

# Required Environment Variables
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-chars
NEXT_PUBLIC_APP_URL=https://disaster-recovery-seven-virid.vercel.app
NEXTAUTH_URL=https://disaster-recovery-seven-virid.vercel.app

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=http://localhost:3001
WEBSOCKET_PORT=3002

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Service
# Sender domain: disasterrecovery.au is the verified Resend domain (DR-524).
# Body content links to disasterrecovery.com.au; only FROM uses the .au variant.
EMAIL_FROM=noreply@disasterrecovery.au
RESEND_FROM_EMAIL=noreply@disasterrecovery.au
RESEND_API_KEY=
SENDGRID_API_KEY=

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GOOGLE_GENAI_API_KEY=your_google_genai_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Voice/Audio Services (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Voice agent (Sarah on 1300) — DR-706 epic ----
# Feature flag for the ElevenLabs post-call webhook. Keep false until
# the agent is live-tested end-to-end (DR-710..DR-716 must land first).
VOICE_AGENT_ENABLED=false
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_AGENT_ID_SARAH=agent_8601kpnzctztf4xvh3chdhw60dcz
ELEVENLABS_AGENT_ID_MAYA=agent_3401kpp0eb4nf5fsfjj6nppkqrak
ELEVENLABS_AGENT_ID_OLIVIA=agent_7401kq4k2xd9ep9rbsngfy40jp60

# ---- ElevenLabs convai web widget (browser-based voice) ----
# When true, the in-page voice widget renders on /contractor/apply
# (Olivia) and /claim (Sarah/Tannika). APP 8 consent modal gates the
# widget script load — declining never injects the script.
NEXT_PUBLIC_VOICE_WIDGET_ENABLED=false

# Storage (AWS S3 / Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=nrp-disaster-recovery

# =============================================================================
# DR-390 — Property Access PII Encryption
# =============================================================================
# KMS_KEY_ID: ARN of the AWS KMS Customer Managed Key (CMK) used for
#   envelope encryption of property access instructions (alarm codes, gate
#   codes, key-safe codes). When set, @aws-sdk/client-kms must also be
#   installed: npm install @aws-sdk/client-kms
#   Example: arn:aws:kms:ap-southeast-2:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   TODO (DR-390): Provision CMK in ap-southeast-2 and update this value before go-live.
KMS_KEY_ID=

# ENCRYPTION_SECRET: Fallback AES-256-GCM secret used when KMS is not
#   configured. Must be a cryptographically random string of at least 32
#   characters. Generate with: openssl rand -hex 32
#   This is used only if KMS_KEY_ID is NOT set.
#   NEVER commit a real value to source control.
ENCRYPTION_SECRET=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Processing (Stripe)
# Live secret key (sk_live_*) — server-only. SECRET data class.
STRIPE_SECRET_KEY=
# Live publishable key (pk_live_*) — exposed to browser via NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Legacy alias kept for back-compat — prefer NEXT_PUBLIC_ above.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_*) for the endpoint at
# https://disasterrecovery.com.au/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — created via scripts/setup-stripe-products.mjs.
# Live IDs in acct_1GNs4CC8kkd3m9ZX (Disaster Recovery Qld Pty Ltd, 2026-04-26).
# These env vars override the fallback IDs hardcoded in src/lib/stripe.ts;
# use them in Vercel Production for the live account, and add sk_test_/pk_test_
# equivalents in Preview env for test mode (DR-509).
#
# One-time fees
STRIPE_APPLICATION_FEE_PRICE_ID=
STRIPE_JOINING_FEE_PRICE_ID=
STRIPE_PERFORMANCE_BOND_PRICE_ID=
STRIPE_CALLOUT_FEE_PRICE_ID=
# Territory subscription tiers (recurring monthly)
STRIPE_SUB_TIER_25KM_PRICE_ID=
STRIPE_SUB_TIER_50KM_PRICE_ID=
STRIPE_SUB_TIER_75KM_PRICE_ID=
STRIPE_SUB_TIER_100KM_PRICE_ID=
# Promotional schedule prices (introductory 3-month offer on base tier)
STRIPE_SUB_MONTH_1_PRICE_ID=
STRIPE_SUB_MONTH_2_PRICE_ID=
STRIPE_SUB_MONTH_3_PRICE_ID=
STRIPE_SUB_REGULAR_PRICE_ID=

# Maps and Geolocation
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Clean Claims API Integration
CLEAN_CLAIMS_API_URL=https://api.cleanclaims.com/v1
CLEAN_CLAIMS_API_KEY=
CLEAN_CLAIMS_WEBHOOK_SECRET=

# Background Check Service
BACKGROUND_CHECK_API_URL=https://api.backgroundcheck.com/v1
BACKGROUND_CHECK_API_KEY=
BACKGROUND_CHECK_WEBHOOK_URL=https://disaster-recovery-seven-virid.vercel.app/api/webhooks/background-check

# Google Indexing API (for submitting URLs to Google Search Console)
GOOGLE_INDEXING_KEY_PATH=

# Google Places API (New) — live star ratings on location pages
GOOGLE_PLACES_API_KEY=

# Analytics
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ────── Vercel observability ──────
# @vercel/analytics + @vercel/speed-insights auto-report to your Vercel project.
# No DSN needed — authentication via Vercel project token at build time.
# For local dev, observability degrades to structured console logs.
#
# Optional: enable Log Drains via Vercel dashboard (Project → Settings → Log Drains)
# to stream runtime logs to any HTTPS endpoint (Datadog, S3, self-hosted collector).

# HRM (Hierarchical Reasoning Model) Configuration
HRM_MODEL_PATH=
HRM_API_ENDPOINT=http://localhost:8080/hrm
HRM_API_KEY=
HRM_MAX_CYCLES=16
HRM_HALT_MAX_STEPS=16
HRM_TEMPERATURE=0.1
HRM_DEVICE=cuda

# Orchestration Settings
ORCHESTRATION_DEFAULT_APPROACH=hrm
ORCHESTRATION_MAX_RETRIES=3
ORCHESTRATION_ENABLE_CACHING=true
ORCHESTRATION_ENABLE_MONITORING=true
ORCHESTRATION_ENABLE_HRM=true

# Performance Settings
CACHE_MAX_SIZE=100000000
CACHE_TTL=3600
MONITORING_RETENTION_DAYS=7

# Feature Flags
ENABLE_AUDIO=true
ENABLE_WEBSOCKET=true
ENABLE_NOTIFICATIONS=true
ENABLE_CHAT=true
ENABLE_2FA=false
ENABLE_API_RATE_LIMITING=true
ENABLE_BACKGROUND_CHECKS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_COOKIE_NAME=nrp-session
SESSION_COOKIE_MAX_AGE=86400

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://disaster-recovery-seven-virid.vercel.app,https://disaster-recovery-staging.vercel.app

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Bot System Specific
BOT_API_PORT=3001
BOT_WS_PORT=3002
BOT_HEALTH_CHECK_INTERVAL=30000

# Security
JWT_SECRET=
JWT_REFRESH_SECRET=

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please check back soon."

# IMPORTANT: When setting up environment variables in Vercel:
# 1. Go to Settings > Environment Variables
# 2. Set NEXT_PUBLIC_APP_URL to https://disaster-recovery-seven-virid.vercel.app for Production
# 3. Set NEXTAUTH_URL to https://disaster-recovery-seven-virid.vercel.app for Production
# 4. For Staging, use disaster-recovery-staging.vercel.app domain
# 5. NEVER reference disasterrecovery.com.au in env variables

# DR-711 topic classifier
VOICE_DENY_LIST_JSON=[]

# DR-707 Twilio voice consent gate
TWILIO_HUMAN_QUEUE_NUMBER=

# DR-712 consumer Stripe payments (flag-gated)
NEXT_PUBLIC_CONSUMER_PAYMENTS_ENABLED=false
DR_PLATFORM_FEE_CENTS=33000
DR_CURRENCY=aud
DR_CHECKOUT_SUCCESS_URL=https://disasterrecovery.com.au/claim/paid?session_id={CHECKOUT_SESSION_ID}
DR_CHECKOUT_CANCEL_URL=https://disasterrecovery.com.au/claim/cancelled
DR_FORCE_3DS_ABOVE_CENTS=50000

# Equipped Commercial Finance — referral flow (L1/L6, flag-gated)
# Reg 25 NCCP Regulations referrer arrangement with SME Consulting Group Pty Ltd
# T/As Equipped Commercial Finance (ABN 53 662 478 408, ACR 544113).
# Master flag: turn the entire referral surface on/off without redeploy.
NEXT_PUBLIC_EQUIPPED_REFERRAL_ENABLED=false
# Shared secret used to sign the 15-minute handoff JWT issued at
# POST /api/finance/referral and verified at GET /finance/handoff.
# Use a 32+ char random value in production; never commit a real secret.
JWT_SECRET_KEY=
# Header `kid` claim placed on every handoff JWT. Bump when rotating
# JWT_SECRET_KEY and update the verifier's key map at the same time.
EQUIPPED_JWT_KID=dr-2026-04
# Equipped's HMAC secret for inbound webhooks at POST /api/finance/status.
# Format: header `Equipped-Signature: t=<unix-secs>,v0=<hex-hmac-sha256(t.body)>`.
EQUIPPED_WEBHOOK_SECRET=
# Origin used for iframe target + postMessage targetOrigin guard.
# Override for staging, e.g. https://staging.equippedcf.com.au.
NEXT_PUBLIC_EQUIPPED_EMBED_ORIGIN=https://equippedcf.com.au
# Full URL of Equipped's embed endpoint. When unset, falls back to
# `${NEXT_PUBLIC_EQUIPPED_EMBED_ORIGIN}/get-a-quote` (no JWT consumption).
# Set to https://equippedcf.com.au/embed once Equipped stands up that route.
NEXT_PUBLIC_EQUIPPED_EMBED_URL=
