# Workflows the PR release gate may start by hand on a feature branch
# (gh workflow run <file> --ref <branch>) so GitHub runs the real PR checks on the exact
# head before the PR is opened. One workflow file name per line. DR-974.
#
# gitleaks.yml is deliberately NOT listed: on a manual run gitleaks-action scans the whole
# history, reports the known historical leaks and fails, which blocks the gate. It still
# runs on every pull request, where it scans only the PR's commits.
ci.yml
pre-build-check.yml
