  // Approval Chain
  technicalReviewerId  String?
  technicalReviewer    User?     @relation("TechnicalReviews", fields: [technicalReviewerId], references: [id])
  technicalReviewDate  DateTime?
  technicalReviewNotes String?   @db.Text

  managerReviewerId  String?
  managerReviewer    User?     @relation("ManagerReviews", fields: [managerReviewerId], references: [id])
  managerReviewDate  DateTime?
  managerReviewNotes String?   @db.Text

  finalApproverId   String?
  finalApprover     User?     @relation("FinalApprovals", fields: [finalApproverId], references: [id])
  finalApprovalDate DateTime?

  // Report Content
  executiveSummary String? @db.Text
  scopeOfWork      String  @db.Text
  findings         String  @db.Text
  recommendations  String  @db.Text
  limitations      String? @db.Text

  // Damage Assessment
  damageAreas      DamageArea[]
  moistureReadings MoistureReading[]
  photos           InspectionPhoto[]

  // Cost Estimation
  costEstimate CostEstimate?

  // PDF Generation
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  pdfVersion     Int       @default(0)

  // Compliance Validation
  complianceChecks ComplianceCheck[]
  complianceStatus String? // "COMPLIANT", "NON_COMPLIANT", "REQUIRES_REVIEW"

  // Audit Trail
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  createdBy String
  creator   User             @relation("CreatedReports", fields: [createdBy], references: [id])
  revisions ReportRevision[]

  @@index([bookingId])
  @@index([status])
  @@index([jurisdiction])
  @@index([reportNumber])
  @@index([inspectorId])
  @@map("inspection_reports")
}

model DamageArea {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Location
  areaName String // "Master Bedroom", "Kitchen"
  floor    String // "Ground Floor", "First Floor"
  roomType String // "Bedroom", "Kitchen", "Bathroom"

  // Damage Assessment
  damageCategory    DamageCategory
  affectedArea      Float // Square meters
  affectedMaterials String[] // ["Carpet", "Drywall", "Timber flooring"]

  // Moisture Content
  initialMoistureLevel Float? // %
  targetMoistureLevel  Float? // %

  // Observations
  description String
  severity    String // "Minor", "Moderate", "Severe", "Critical"
  photos      InspectionPhoto[] @relation("AreaPhotos")

  // Required Actions
  requiredActions     String[] // ["Remove carpet", "Dry wall cavity"]
  equipmentNeeded     String[] // ["Air mover", "Dehumidifier"]
  estimatedDryingTime Int? // Hours

  // Cost Tracking
  estimatedCost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("damage_areas")
}

model MoistureReading {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Reading Details
  readingDate DateTime
  location    String // "Master Bedroom - North Wall"
  material    String // "Drywall", "Concrete slab", "Timber"

  // Measurements
  moistureContent    Float // % moisture content
  ambientTemperature Float? // Celsius
  ambientHumidity    Float? // % relative humidity

  // Equipment
  meterType    String // "Pin-type", "Pinless", "Thermal camera"
  readingDepth String? // "Surface", "12mm", "25mm"

  // GPS Location (optional)
  latitude  Float?
  longitude Float?

  // Notes
  notes String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([readingDate])
  @@map("moisture_readings")
}

model InspectionPhoto {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  damageAreaId String?
  damageArea   DamageArea? @relation("AreaPhotos", fields: [damageAreaId], references: [id])

  // Photo Metadata
  photoUrl     String // S3/CloudFlare URL
  thumbnailUrl String?
  filename     String
  fileSize     Int // Bytes
  mimeType     String // "image/jpeg"

  // Categorization
  photoType   String // "BEFORE", "DURING", "AFTER", "EQUIPMENT", "DAMAGE_DETAIL"
  caption     String
  description String?

  // EXIF Data
  capturedAt   DateTime
  gpsLatitude  Float?
  gpsLongitude Float?
  deviceModel  String?

  // Display Order
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([damageAreaId])
  @@index([photoType])
  @@map("inspection_photos")
}

model CostEstimate {
  id       String           @id @default(cuid())
  reportId String           @unique
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Labor Costs
  laborLineItems  LaborLineItem[]
  totalLaborHours Float
  totalLaborCost  Float

  // Material Costs
  materialLineItems MaterialLineItem[]
  totalMaterialCost Float

  // Equipment Costs
  equipmentLineItems EquipmentLineItem[]
  totalEquipmentCost Float

  // Subtotals
  subtotal  Float
  gst       Float // 10% in Australia
  totalCost Float

  // Pricing Metadata
  pricingDate   DateTime        @default(now())
  jurisdiction  AustralianState
  pricingSource String // "NRPG_2025_Q1_RATES"

  // Contingency
  contingencyPercent Float @default(10)
  contingencyAmount  Float

  // Notes
  assumptions    String? @db.Text
  exclusions     String? @db.Text
  validityPeriod Int     @default(30) // Days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("cost_estimates")
}

model LaborLineItem {
  id             String       @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)

  description String // "Water extraction - Category 1"
  taskCode    String // "WE-C1"

  // Labor Details
  iicrcLevel String // "WRT", "AMRT", "Technician"
  hours      Float
  hourlyRate Float

  // Calculation
  subtotal Float

  // Metadata
  jurisdiction      AustralianState
  rateEffectiveDate DateTime

  createdAt DateTime @default(now())

  @@index([costEstimateId])
  @@map("labor_line_items")
}

model MaterialLineItem {
  id             String       @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)

  description  String // "Antimicrobial treatment - 50L"
  materialCode String // "AM-50L"

  // Material Details
  quantity  Float
  unit      String // "L", "kg", "m2", "each"
  unitPrice Float

  // Supplier
  supplierName String?
  supplierSKU  String?

  // Calculation
  subtotal Float

  // Metadata
  jurisdiction       AustralianState
  priceEffectiveDate DateTime

  createdAt DateTime @default(now())

  @@index([costEstimateId])
  @@map("material_line_items")
}

model EquipmentLineItem {
  id             String       @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)

  description   String // "Commercial dehumidifier - 7 days"
  equipmentCode String // "DEHUM-COM"

  // Rental Details
  quantity   Int
  rentalDays Int
  dailyRate  Float

  // Calculation
  subtotal Float

  // Metadata
  jurisdiction      AustralianState
  rateEffectiveDate DateTime

  createdAt DateTime @default(now())

  @@index([costEstimateId])
  @@map("equipment_line_items")
}

model ComplianceCheck {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Check Details
  checkName    String // "QLD Building Code 2022 - Water Damage"
  checkCode    String // "QLD-BC-2022-WD"
  jurisdiction AustralianState

  // Compliance Result
  status   String // "PASS", "FAIL", "NOT_APPLICABLE", "REQUIRES_REVIEW"
  required Boolean @default(true)

  // Evidence
  evidence         String? @db.Text // How compliance was achieved
  referenceSection String? // "Section 4.2.3"

  // Validation
  validatedBy String?
  validatedAt DateTime?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([status])
  @@map("compliance_checks")
}

model ReportRevision {
  id       String           @id @default(cuid())
  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  version        Int
  revisionReason String // "Client requested changes", "Compliance update"
  changedBy      String
  changedByUser  User   @relation("ReportRevisions", fields: [changedBy], references: [id])

  // Snapshot
  snapshotData Json // Full report state at this version
  pdfUrl       String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([version])
  @@map("report_revisions")
}
