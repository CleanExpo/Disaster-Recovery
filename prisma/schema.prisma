// Disaster Recovery SaaS Platform - Unified Schema
// Combines multi-tenant infrastructure with Australian disaster recovery services
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS - AUSTRALIAN LOCALIZATION & MULTI-TENANT
// ============================================================================

enum UserType {
  CLIENT
  CONTRACTOR
  ADMIN
  SUPER_ADMIN
}

enum AustralianState {
  NSW // New South Wales
  VIC // Victoria
  QLD // Queensland
  WA // Western Australia
  SA // South Australia
  TAS // Tasmania
  ACT // Australian Capital Territory
  NT // Northern Territory
}

enum IICRCCertificationLevel {
  TECHNICIAN
  SUPERVISOR
  INSPECTOR
  MASTER
}

enum AustralianServiceType {
  // Residential Services
  WATER_DAMAGE
  FIRE_DAMAGE
  SMOKE_DAMAGE
  MOULD_REMEDIATION
  ODOUR_REMEDIATION
  CARPET_CLEANING

  // Commercial Services
  COMMERCIAL_WATER_DAMAGE
  COMMERCIAL_FIRE_DAMAGE
  COMMERCIAL_MOULD
  COMMERCIAL_ODOUR

  // Specialized/Biohazard Services
  CRIME_SCENE_CLEANING
  BIOHAZARD_REMEDIATION
  HOARDING_CLEANUP
  VANDALISM_CLEANUP

  // General
  GENERAL_RESTORATION
}

enum EmergencyResponseLevel {
  URGENT // < 2 hours
  HIGH // Same day
  STANDARD // Next business day
  SCHEDULED // Pre-arranged appointment
}

enum InsuranceProviderType {
  NRMA
  SUNCORP
  ALLIANZ
  QBE
  IAG
  CGU
  MEDIBANK
  OTHER
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  PAYMENT_PROCESSED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum ServiceStatus {
  PENDING
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MessageType {
  GENERAL
  MATCH_NOTIFICATION
  PROJECT_UPDATE
  PAYMENT_REMINDER
  SYSTEM_NOTIFICATION
  INITIATE_CHAT
  BID_ACCEPTED
  BID_REJECTED
}

// ============================================================================
// MULTI-TENANT CORE MODELS
// ============================================================================

model Tenant {
  id             String   @id @default(cuid())
  name           String
  domain         String?  @unique
  subdomain      String?  @unique
  logo           String?
  primaryColor   String?
  secondaryColor String?
  customCss      String?
  industry       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  contractorProfiles ContractorProfile[]
  messages           Message[]
  serviceRequests    ServiceRequest[]
  configurations     TenantConfiguration[]
  users              User[]

  @@map("tenants")
}

model TenantConfiguration {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_configurations")
}

// ============================================================================
// CORE MODELS - USERS & AUTHENTICATION
// ============================================================================

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  password String?
  userType UserType @default(CLIENT)
  googleId String?  @unique
  avatar   String?

  // Australian Contact Info
  australianPhoneNumber String?
  australianPostcode    String?
  australianState       AustralianState?
  suburb                String?
  streetAddress         String?

  // Account Status
  isEmailVerified              Boolean   @default(false)
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?
  isActive                     Boolean   @default(true)
  isBlocked                    Boolean   @default(false)
  lastLoginAt                  DateTime?

  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  contractor            Contractor?
  contractorProfile     ContractorProfile?
  contractorPreferences ContractorPreferences?
  receivedMessages      Message[]              @relation("MessageReceiver")
  sentMessages          Message[]              @relation("MessageSender")
  serviceRequests       ServiceRequest[]
  preferences           UserPreferences?
  bookings              Booking[]              @relation("ClientBookings")
  payments              Payment[]
  auClaims              InsuranceClaimAU[]     @relation("ClientClaims")
  auInvoices            InvoiceAU[]            @relation("ClientInvoices")
  loginAttempts         LoginAttempt[]
  verificationTokens    VerificationToken[]
  ratings               Rating[]

  // CRM Relations
  lifecycle            CustomerLifecycle? @relation("CustomerLifecycle")
  activitiesPerformed  Activity[]         @relation("ActivityPerformer")
  activitiesAsCustomer Activity[]         @relation("ActivityCustomer")
  tasksAssigned        Task[]             @relation("TaskAssignee")
  tasksCreated         Task[]             @relation("TaskCreator")
  businessRules        BusinessRule[]     @relation("BusinessRuleOwner")

  // NRPG Inspection Relations
  inspectionReports            InspectionReport[]             @relation("InspectorReports")
  technicalReviews             InspectionReport[]             @relation("TechnicalReviews")
  managerReviews               InspectionReport[]             @relation("ManagerReviews")
  finalApprovals               InspectionReport[]             @relation("FinalApprovals")
  createdReports               InspectionReport[]             @relation("CreatedReports")
  reportRevisions              ReportRevision[]               @relation("ReportRevisions")
  ServiceRequestCalloutPayment ServiceRequestCalloutPayment[]
  ClientProfile                ClientProfile?

  // SaaS Workspace Relations
  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  invitedMembers       WorkspaceMember[]   @relation("MemberInviter")
  workspaceAuditLogs   WorkspaceAuditLog[] @relation("WorkspaceAuditLogs")

  // Real-time Connection Logs
  connectionLogs ConnectionLog[] @relation("UserConnectionLogs")

  @@index([email])
  @@index([userType])
  @@index([australianState])
  @@index([isActive])
  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  interests            String[]
  serviceTypes         String[]
  budgetRange          String?
  urgencyLevel         String?
  communicationStyle   String?
  notificationSettings Json?
  dashboardLayout      Json?
  themePreferences     Json?
  isOnboardingComplete Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  brandingColor        String?
  selectedTheme        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  userId      String
  ipAddress   String
  userAgent   String
  success     Boolean
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ipAddress])
  @@index([attemptedAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String // "EMAIL_VERIFICATION", "PASSWORD_RESET", "2FA"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================================================
// CONTRACTOR & CERTIFICATIONS
// ============================================================================

model Contractor {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business Information
  businessName             String
  abnNumber                String?   @unique // Australian Business Number
  acnNumber                String?   @unique // Australian Company Number
  businessRegistrationDate DateTime?

  // Location Information
  primaryPostcode String?
  primaryState    AustralianState?
  operatingStates AustralianState[]

  // IICRC Certifications
  iicrcCertifications IICRCCertification[] @relation("ContractorCertifications")

  // Service Areas
  serviceAreas ContractorServiceArea[] @relation("ServiceAreas")

  // NRPG Membership
  nrpgMemberId          String?   @unique // National Restoration Professionals Group
  nrpgVerifiedAt        DateTime?
  nrpgVerificationLevel String? // "VERIFIED", "PENDING", "PENDING_INFO", "SUSPENDED", "REJECTED"

  // Australian Service Specialties
  australianSpecialties    AustralianServiceType[]
  supportedEmergencyLevels EmergencyResponseLevel[]

  // Insurance Details
  publicLiabilityPolicyNumber   String?
  publicLiabilityExpiryDate     DateTime?
  publicLiabilityCertificateUrl String? // Insurance Certificate of Currency (COI)
  workCoverNumber               String?
  workCoverExpiryDate           DateTime?

  // Performance Metrics
  completedJobs              Int       @default(0)
  averageRating              Decimal   @default(0.00) // 0-5 stars
  averageResponseTimeMinutes Int       @default(0)
  isVerified                 Boolean   @default(false)
  verificationDate           DateTime?

  // Background Check
  lastBackgroundCheckDate DateTime?
  backgroundCheckStatus   String? // "PASS", "FAIL", "PENDING"

  // Status
  isActive         Boolean @default(true)
  isSuspended      Boolean @default(false)
  suspensionReason String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings   Booking[]   @relation("ContractorBookings")
  payments   Payment[]   @relation("ContractorPayments")
  auInvoices InvoiceAU[] @relation("ContractorInvoices")
  ratings    Rating[]

  // CRM Relations
  opportunities Opportunity[] @relation("OpportunityContractor")
  activities    Activity[]    @relation("ActivityContractor")

  // Real-time Job Coordination
  realtimeSubscription   RealtimeSubscription?   @relation("ContractorRealtimeSubscription")
  notificationPreference NotificationPreference? @relation("ContractorNotificationPreference")

  @@index([businessName])
  @@index([primaryState])
  @@index([nrpgMemberId])
  @@index([isVerified])
  @@index([isActive])
  @@index([abnNumber])
}

model IICRCCertification {
  id String @id @default(cuid())

  contractorId String
  contractor   Contractor @relation("ContractorCertifications", fields: [contractorId], references: [id], onDelete: Cascade)

  // Certification Details
  certificationLevel IICRCCertificationLevel
  certificationCode  String                  @unique
  certificationDate  DateTime
  expiryDate         DateTime
  verificationDate   DateTime?

  // Status
  isActive   Boolean @default(true)
  verifiedBy String?

  // Documentation
  certificatePdfUrl   String?
  certificateFileName String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractorId, certificationLevel, certificationCode])
  @@index([contractorId])
  @@index([certificationCode])
  @@index([expiryDate])
  @@index([isActive])
}

model ContractorServiceArea {
  id String @id @default(cuid())

  contractorId String
  contractor   Contractor @relation("ServiceAreas", fields: [contractorId], references: [id], onDelete: Cascade)

  // Postcode Information (4 digits in Australia)
  postcode String // e.g., "2000", "3141"
  state    AustralianState

  // Service Details
  isActive            Boolean @default(true)
  responseTimeMinutes Int

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractorId, postcode])
  @@index([postcode])
  @@index([state])
  @@index([contractorId])
}

// ============================================================================
// ADMIN SERVICE MANAGEMENT
// ============================================================================

model AdminServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  theme       String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services AdminService[]

  @@map("admin_service_categories")
}

model AdminService {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  icon        String?
  theme       String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category AdminServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@map("admin_services")
}

model AdminTheme {
  id              String   @id @default(cuid())
  name            String
  identifier      String   @unique
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  textColor       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("admin_themes")
}

// ============================================================================
// SERVICE REQUESTS & MATCHING (MULTI-TENANT)
// ============================================================================

model ServiceRequest {
  id              String        @id @default(cuid())
  userId          String
  serviceCategory String
  urgency         String
  serviceTitle    String
  description     String
  location        String
  budget          String?
  phone           String?
  preferredTime   String?
  insurance       Boolean       @default(false)
  urgentResponse  Boolean       @default(false)
  status          ServiceStatus @default(PENDING)
  leadScore       Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenantId        String?

  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant?                       @relation(fields: [tenantId], references: [id])
  matches        ContractorMatch[]
  calloutPayment ServiceRequestCalloutPayment?

  // CRM Relations
  opportunity Opportunity? @relation("OpportunityServiceRequest")

  @@map("service_requests")
}

enum CalloutPaymentStatus {
  CREATED
  CHECKOUT_CREATED
  PAID
  RELEASED
  REFUNDED
  CANCELLED
}

model ServiceRequestCalloutPayment {
  id                  String  @id @default(cuid())
  serviceRequestId    String  @unique
  clientId            String
  contractorProfileId String?

  // Pricing (AUD)
  totalAUD                      Decimal
  totalExGstAUD                 Decimal
  gstAUD                        Decimal
  platformFeeAUD                Decimal
  platformFeeExGstAUD           Decimal
  platformFeeGstAUD             Decimal
  contractorEntitlementAUD      Decimal
  contractorEntitlementExGstAUD Decimal
  contractorEntitlementGstAUD   Decimal
  gstInclusive                  Boolean @default(true)

  status CalloutPaymentStatus @default(CREATED)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeTransferId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequest    ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  client            User               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractorProfile ContractorProfile? @relation(fields: [contractorProfileId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([contractorProfileId])
  @@index([status])
  @@map("service_request_callout_payments")
}

model ContractorProfile {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  businessName           String?
  phone                  String?
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  licenseNumber          String?
  insuranceProvider      String?
  insuranceExpiry        DateTime?
  services               String[]
  serviceAreas           String[]
  hourlyRate             Float?
  experience             Int                @default(0)
  rating                 Float              @default(0.0)
  totalJobs              Int                @default(0)
  bio                    String?
  availability           AvailabilityStatus @default(AVAILABLE)
  isVerified             Boolean            @default(false)
  stripeConnectAccountId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  tenantId               String?

  user                         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                       Tenant?                        @relation(fields: [tenantId], references: [id])
  matches                      ContractorMatch[]
  ServiceRequestCalloutPayment ServiceRequestCalloutPayment[]

  @@map("contractor_profiles")
}

model ContractorMatch {
  id                String      @id @default(cuid())
  contractorId      String
  serviceRequestId  String
  matchScore        Float
  status            MatchStatus @default(PENDING)
  contractorMessage String?
  clientMessage     String?
  budget            String?
  timeline          String?
  startDate         String?
  estimatedHours    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  contractor     ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest    @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("contractor_matches")
}

model ContractorPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  serviceCategories    String[]
  locations            String[]
  experience           String?
  expertise            String[]
  background           String?
  hourlyRate           String?
  availability         String?
  maxDistance          String?
  selectedTheme        String?
  brandingColor        String?
  isOnboardingComplete Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contractor_preferences")
}

// ============================================================================
// CLIENT ONBOARDING & PROFILES
// ============================================================================

model ClientProfile {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  displayName             String?
  phoneNumber             String?
  phoneNumberVerified     Boolean @default(false)
  preferredContactMethod  String  @default("email")
  timezone                String  @default("Australia/Sydney")
  language                String  @default("en-AU")
  propertyOwnershipStatus String?
  propertyCount           Int     @default(1)
  isProfileComplete       Boolean @default(false)

  // High-value client tier
  tier                 String  @default("standard") // standard, property_manager, verified_insurance, repeat, high_value
  vipAssignedManagerId String?

  // Risk assessment
  riskZone                String? // flood_zone, bushfire_zone, cyclone_zone
  riskAssessmentOffered   Boolean @default(false)
  riskAssessmentCompleted Boolean @default(false)

  // Data integrity flags
  flaggedForReview Boolean @default(false)
  flagReason       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties        ClientProperty[]
  insurance         ClientInsurance?
  payment           ClientPayment?
  emergencyContacts ClientEmergencyContact[]
  onboarding        ClientOnboarding?

  @@index([tier])
  @@index([riskZone])
  @@index([flaggedForReview])
  @@map("client_profiles")
}

model ClientProperty {
  id              String          @id @default(cuid())
  clientProfileId String
  streetAddress   String
  suburb          String
  postcode        String
  state           AustralianState
  country         String          @default("AU")
  propertyType    String // residential_house, residential_unit, townhouse, commercial_office, commercial_retail, industrial
  propertySize    String?
  buildingAge     String?

  // Encrypted access instructions (client-specific encryption key)
  accessInstructions String?   @db.Text
  accessKeyId        String? // AWS KMS key ID for decryption
  accessDecryptedAt  DateTime? // Last time access instructions were revealed
  accessDecryptedBy  String? // Contractor ID who viewed it

  parkingAvailable Boolean @default(true)
  securityAccess   Boolean @default(false)
  petOnPremises    Boolean @default(false)
  petDetails       String? // "2 small dogs - friendly"

  // Preventive service recommendations (auto-populated based on risk zone)
  recommendedServices String[]

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId])
  @@index([postcode])
  @@index([state])
  @@map("client_properties")
}

model ClientInsurance {
  id                 String    @id @default(cuid())
  clientProfileId    String    @unique
  hasInsurance       Boolean   @default(false)
  insuranceProvider  String? // NRMA, Suncorp, Allianz, QBE, IAG, CGU, Medibank, Other
  policyNumber       String?
  policyExpiryDate   DateTime?
  policyDocumentUrls String[] // S3/Cloudinary URLs

  // Verification status
  policyVerified Boolean   @default(false)
  verifiedAt     DateTime?
  verifiedBy     String? // Admin user ID

  // Claims history
  hasPreviousClaims Boolean   @default(false)
  claimCount        Int       @default(0)
  lastClaimDate     DateTime?

  // Contractor preferences
  preferredContractors  String[] // Contractor IDs
  restrictedContractors String[] // Contractor IDs to exclude

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([policyExpiryDate])
  @@index([policyVerified])
  @@map("client_insurance")
}

model ClientPayment {
  id                    String  @id @default(cuid())
  clientProfileId       String  @unique
  stripeCustomerId      String? @unique
  stripePaymentMethodId String?

  // Payment method metadata (for expiry tracking)
  cardBrand       String? // visa, mastercard, amex
  cardLast4       String?
  cardExpiryMonth Int?
  cardExpiryYear  Int?

  // Billing address
  billingAddressSameAs Boolean          @default(true)
  billingStreet        String?
  billingSuburb        String?
  billingPostcode      String?
  billingState         AustralianState?

  // Preferences
  autoPayEnabled        Boolean @default(false)
  invoiceDeliveryMethod String  @default("email") // email, postal, both
  taxInvoiceRecipient   String?
  abnNumber             String? // If business client

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([cardExpiryMonth, cardExpiryYear]) // For expiry reminders
  @@map("client_payments")
}

model ClientEmergencyContact {
  id                     String   @id @default(cuid())
  clientProfileId        String
  name                   String
  relationship           String
  phone                  String
  email                  String?
  allowContractorContact Boolean  @default(false)
  isPrimary              Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId])
  @@index([isPrimary])
  @@map("client_emergency_contacts")
}

model ClientOnboarding {
  id       String @id @default(cuid())
  clientId String @unique

  // Timeline
  startDate            DateTime?
  targetCompletionDate DateTime? // 7 days from start
  actualCompletionDate DateTime?

  // Progress
  status          OnboardingStatus @default(PENDING_START) // PENDING_START, IN_PROGRESS, COMPLETED
  currentPhase    String? // profile, services, property, insurance, payment, communication, education
  completedPhases String[] // Array of completed phase names

  // Flow variant (for A/B testing)
  flowVariant  String? // standard, fast_track, vip
  experimentId String? // A/B test experiment ID

  // Completion
  certificateIssued   Boolean @default(false)
  certificateUrl      String?
  tourCompleted       Boolean @default(false)
  firstRequestCreated Boolean @default(false)
  badgeAwarded        Boolean @default(false)

  // Analytics
  totalTimeSpentSeconds Int     @default(0)
  deviceType            String? // mobile, desktop, tablet
  browserLanguage       String? // For localization analytics

  // Abandonment tracking
  lastActivityAt DateTime?
  abandonedAt    DateTime?
  abandonedPhase String?
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile  ClientProfile          @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  moduleProgress ClientModuleProgress[]

  @@index([status])
  @@index([currentPhase])
  @@index([flowVariant])
  @@index([lastActivityAt]) // For abandonment detection
  @@map("client_onboarding")
}

model ClientModuleProgress {
  id           String       @id @default(cuid())
  onboardingId String
  moduleId     String // MODULE-001, MODULE-002, etc.
  moduleName   String?
  startedAt    DateTime?
  completedAt  DateTime?
  completed    Boolean      @default(false)
  status       ModuleStatus @default(NOT_STARTED)
  progress     Int          @default(0) // 0-100%

  // Optional quiz (education verification)
  quizScore    Int? // 0-100%
  quizAttempts Int     @default(0)
  quizPassed   Boolean @default(false) // 70%+ to pass

  // Analytics
  timeSpentSeconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@index([status])
  @@index([completed])
  @@map("client_module_progress")
}

// ============================================================================
// SAAS WORKSPACE & SUBSCRIPTION SYSTEM
// ============================================================================

enum SubscriptionTier {
  BASIC // $99/month, 1 seat, 10 jobs
  PRO // $299/month, 5 seats, 50 jobs
  ENTERPRISE // $799/month, unlimited seats/jobs
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum WorkspaceMemberRole {
  OWNER // Full control, billing admin
  MANAGER // Can accept jobs, manage team
  TECHNICIAN // Can update status, view assigned jobs
  ADMIN_STAFF // View jobs, handle invoices
}

model Workspace {
  id           String  @id @default(cuid())
  businessName String
  abnNumber    String? @unique
  acnNumber    String?

  // Subscription
  subscriptionTier     SubscriptionTier   @default(BASIC)
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  // Tier Limits
  seatLimit       Int @default(1) // 1, 5, unlimited
  monthlyJobLimit Int @default(10) // 10, 50, unlimited
  serviceRadiusKm Int @default(25) // Geographic coverage

  // Usage Tracking
  currentMonthJobs   Int     @default(0) // Resets monthly
  totalJobsCompleted Int     @default(0) // All-time
  totalOverageFees   Decimal @default(0) // Track overage charges

  // CRM Integration
  crmType          String? // 'nrpg_basic', 'servicem8', 'fergus', 'tradify', 'custom'
  crmApiKey        String? // Hashed API key for external CRM
  crmWebhookSecret String? // For signature verification

  // Performance Metrics (for leaderboard)
  completionRate      Decimal @default(0) // Job completion %
  averageRating       Decimal @default(0) // From private client feedback
  averageResponseTime Int     @default(0) // Minutes
  totalDeclines       Int     @default(0)

  // Status
  isActive    Boolean   @default(true)
  suspendedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownerId       String
  owner         User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  rotationQueue ContractorRotation[]
  auditLogs     WorkspaceAuditLog[]

  @@index([subscriptionStatus])
  @@index([subscriptionTier])
  @@index([abnNumber])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(TECHNICIAN)

  // Invitation tracking
  invitedBy String?
  invitedAt DateTime?
  joinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter   User?     @relation("MemberInviter", fields: [invitedBy], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model ContractorRotation {
  id          String @id @default(cuid())
  workspaceId String
  postcode    String // Service area postcode

  // Rotation tracking
  lastJobReceivedAt DateTime?
  totalJobsReceived Int       @default(0)
  totalJobsDeclined Int       @default(0)
  declineRate       Decimal   @default(0)

  // Availability
  availabilityStatus String @default("available") // available, busy, offline

  // Radius
  serviceRadiusKm Int @default(25)

  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, postcode])
  @@index([postcode])
  @@index([lastJobReceivedAt])
  @@index([availabilityStatus])
  @@map("contractor_rotation")
}

model WorkspaceAuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String // 'job_viewed', 'job_accepted', 'job_declined', 'payment_processed', etc.
  entityType  String? // 'incident', 'workspace', 'subscription', 'training'
  entityId    String?
  metadata    Json? // Action-specific details
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation("WorkspaceAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("workspace_audit_logs")
}

// ============================================================================
// BOOKINGS & JOBS
// ============================================================================

model Booking {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)

  contractorId String?
  contractor   Contractor? @relation("ContractorBookings", fields: [contractorId], references: [id], onDelete: SetNull)

  // Service Information
  australianServiceType      AustralianServiceType
  description                String
  estimatedDamagePhotosCount Int                   @default(0)

  // Location (Australian-specific)
  servicePostcode String
  serviceState    AustralianState
  serviceSuburb   String
  streetAddress   String

  // Status & Timeline
  status                 BookingStatus          @default(PENDING)
  emergencyResponseLevel EmergencyResponseLevel @default(STANDARD)
  scheduledDate          DateTime?
  startedAt              DateTime?
  completedAt            DateTime?

  // Financial
  estimatedCostAUD Decimal
  finalCostAUD     Decimal?

  // Notes
  notes         String?
  internalNotes String?
  clientNotes   String?

  // Media
  damagePhotos String[] // Array of image URLs

  // Insurance Claim Integration
  auClaims InsuranceClaimAU[] @relation("BookingClaims")

  // Relations
  payments Payment[] @relation("BookingPayments")
  ratings  Rating[]

  // CRM Relations
  opportunity Opportunity? @relation("OpportunityBooking")
  activities  Activity[]   @relation("ActivityBooking")

  // NRPG Inspection Relations
  inspectionReports InspectionReport[] @relation("InspectionReportBooking")

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([contractorId])
  @@index([servicePostcode])
  @@index([serviceState])
  @@index([status])
  @@index([emergencyResponseLevel])
}

// ============================================================================
// PAYMENTS & INVOICING
// ============================================================================

model Payment {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  contractorId String?
  contractor   Contractor? @relation("ContractorPayments", fields: [contractorId], references: [id], onDelete: SetNull)

  // Payment Details (AUD)
  amountAUD             Decimal // Total amount
  platformFeeAUD        Decimal
  platformFeePercentage Decimal @default(15.00)
  gstAUD                Decimal // 10% GST
  netAmountAUD          Decimal // Amount to contractor after fees

  // Payment Method
  paymentMethod         String // "CREDIT_CARD", "BANK_TRANSFER", "CASH", "CHECK", "INSURANCE"
  stripePaymentIntentId String?
  transactionId         String? @unique

  // Status
  status        PaymentStatus @default(PENDING)
  processedAt   DateTime?
  failureReason String?

  // Receipt/Invoice
  receiptUrl    String?
  invoiceNumber String? @unique

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  auInvoice InvoiceAU?

  @@index([bookingId])
  @@index([clientId])
  @@index([contractorId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceAU {
  id String @id @default(cuid())

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   Contractor @relation("ContractorInvoices", fields: [contractorId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: Cascade)

  // Invoice Details
  invoiceNumber String   @unique
  dateIssued    DateTime @default(now())
  dateDue       DateTime

  // Amounts (AUD)
  subtotalAUD Decimal
  gstAUD      Decimal // 10% GST
  totalAUD    Decimal

  // Status
  isPaid   Boolean   @default(false)
  paidDate DateTime?

  // Description
  description String

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([contractorId])
  @@index([clientId])
  @@index([isPaid])
}

// ============================================================================
// INSURANCE CLAIMS
// ============================================================================

model InsuranceProvider {
  id String @id @default(cuid())

  // Provider Information
  name         String // "NRMA", "Suncorp", etc.
  providerType InsuranceProviderType
  code         String                @unique

  // Contact
  contactEmail String
  contactPhone String

  // API Configuration
  apiEndpoint String?
  apiKey      String? // Encrypted via environment
  webhookUrl  String?

  // Coverage
  supportedStates AustralianState[]

  // Status
  isActive          Boolean @default(true)
  isVerified        Boolean @default(false)
  verificationNotes String?

  // Relations
  claims InsuranceClaimAU[]

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([providerType])
}

model InsuranceClaimAU {
  id String @id @default(cuid())

  // Relationships
  bookingId String
  booking   Booking @relation("BookingClaims", fields: [bookingId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientClaims", fields: [clientId], references: [id], onDelete: Cascade)

  insuranceProviderId String
  insuranceProvider   InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])

  // Insurance Details
  policyNumber String
  claimNumber  String?

  // Financial (AUD)
  totalClaimAmountAUD Decimal
  approvedAmountAUD   Decimal?
  paymentAmountAUD    Decimal?

  // Claim Status
  status InsuranceClaimStatus @default(DRAFT)

  // Documentation
  damageDescription   String
  damagePhotos        String[] // URLs
  invoiceUrl          String?
  estimateUrl         String?
  additionalDocuments String[]

  // Submission Timeline
  submittedAt DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?

  // Rejection Details
  denialReason String?
  deniedAt     DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CRM Relations
  activities Activity[] @relation("ActivityClaim")

  // NRPG Inspection Relations
  inspectionReports InspectionReport[] @relation("InspectionReportClaim")

  @@index([bookingId])
  @@index([clientId])
  @@index([insuranceProviderId])
  @@index([policyNumber])
  @@index([claimNumber])
  @@index([status])
}

// ============================================================================
// RATINGS & REVIEWS
// ============================================================================

model Rating {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  // Rating Details
  rating         Int // 1-5 stars
  comment        String?
  wouldRecommend Boolean @default(true)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, contractorId])
  @@index([contractorId])
  @@index([clientId])
  @@index([rating])
}

// ============================================================================
// MESSAGING
// ============================================================================

model Message {
  id          String      @id @default(cuid())
  senderId    String
  receiverId  String
  requestId   String?
  subject     String?
  content     String
  messageType MessageType @default(GENERAL)
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  tenantId    String?

  sender   User    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  @@map("messages")
}

// ============================================================================
// AUDIT & COMPLIANCE
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  action      String // "CREATE", "UPDATE", "DELETE", "APPROVE", "REJECT"
  entityType  String // "Booking", "Payment", "Contractor", etc.
  entityId    String
  performedBy String? // User ID
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([performedBy])
  @@index([createdAt])
}

// ============================================================================
// ADDITIONAL MODELS FOR FUTURE EXPANSION
// ============================================================================

model RiskAssessment {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  riskScore      Decimal // 0-100
  riskFactors    String[]
  recommendation String // "APPROVE", "REVIEW", "REJECT"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bookingId])
  @@index([riskScore])
}

model DisasterAlert {
  id                String            @id @default(cuid())
  // Disaster Information
  disasterType      String // "FLOOD", "FIRE", "STORM", "CYCLONE"
  severity          String // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  affectedPostcodes String[]
  affectedStates    AustralianState[]
  description       String
  alertUrl          String?
  // Timeline
  startDate         DateTime
  endDate           DateTime?
  // Status
  isActive          Boolean           @default(true)
  isResolved        Boolean           @default(false)
  // Audit
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([disasterType])
  @@index([severity])
  @@index([isActive])
  @@index([startDate])
}

// ============================================================================
// CONTRACTOR ONBOARDING SYSTEM - Phase 24
// ============================================================================

enum OnboardingStatus {
  PENDING_START
  IN_PROGRESS
  PAUSED
  COMPLETED
  EXPIRED
}

enum ModuleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CertificationLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// NRPG Partnership Levels (100-point certification system)
enum NRPGPartnershipLevel {
  CANDIDATE // 60-69 points
  ASSOCIATE // 70-84 points
  PROFESSIONAL // 85-99 points
  EXCELLENCE // 100+ points
}

// NRPG Onboarding Phase Status
enum NRPGPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

// Background Check Status
enum BackgroundCheckStatus {
  NOT_INITIATED
  PENDING
  IN_PROGRESS
  PASS
  FAIL
  EXPIRED
}

model ContractorOnboarding {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId         String           @unique
  specialization       String           @db.VarChar(50)
  assessmentScore      Int?
  recommendedModules   Json?            @db.JsonB
  startDate            DateTime?
  targetCompletionDate DateTime?
  actualCompletionDate DateTime?
  status               OnboardingStatus @default(PENDING_START)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  moduleProgress ContractorModuleProgress[]
  assessments    ContractorAssessment[]

  @@index([status], name: "idx_contractor_status")
  @@index([specialization], name: "idx_contractor_specialization")
  @@index([contractorId], name: "idx_contractor_id_onboarding")
  @@map("contractor_onboarding")
}

model ContractorModuleProgress {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onboardingId String       @db.Uuid
  moduleId     String       @db.VarChar(100)
  courseName   String?      @db.VarChar(255)
  startedAt    DateTime?
  completedAt  DateTime?
  completed    Boolean      @default(false)
  status       ModuleStatus @default(NOT_STARTED)
  progress     Int          @default(0)
  createdAt    DateTime     @default(now())

  onboarding ContractorOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId, status], name: "idx_module_progress")
  @@map("contractor_module_progress")
}

model ContractorAssessment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onboardingId   String    @db.Uuid
  moduleId       String    @db.VarChar(100)
  assessmentType String?   @db.VarChar(50)
  score          Int?
  maxScore       Int       @default(100)
  completedAt    DateTime?
  feedback       String?   @db.Text
  createdAt      DateTime  @default(now())

  onboarding ContractorOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@map("contractor_assessments")
}

model ContractorCertification {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId       String
  certificationName  String    @db.VarChar(255)
  certificationLevel Int?
  issueDate          DateTime?
  expiryDate         DateTime?
  specializations    String[]
  verified           Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([contractorId], name: "idx_contractor_id_cert")
  @@map("contractor_certifications")
}

// ============================================================================
// NRPG CERTIFICATION & ONBOARDING SYSTEM
// 100-Point Certification with 4-Phase Onboarding Workflow
// ============================================================================

model NRPGCertificationPoints {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @unique

  // Category 1: Government Cert IV (40 pts max)
  govCert4Points      Int       @default(0)
  govCert4Status      String?   @db.VarChar(50) // IN_PROGRESS, COMPLETED, EXPERIENCE_BASED
  govCert4EnrolledAt  DateTime?
  govCert4CompletedAt DateTime?

  // Category 2: IICRC Certifications (30 pts max)
  iicrcCorePoints     Int @default(0) // WRT(8), ASD(7), AMRT(5), CCT(4) = 24 pts
  iicrcAdvancedPoints Int @default(0) // FSR(3), UFT(2), TCSC(3) = 8 pts
  iicrcMasterBonus    Int @default(0) // MWR(5), MFSR(5), MTC(3) = 13 bonus

  // Category 3: CARSI Membership & CECs (25 pts max)
  carsiMembershipPoints Int     @default(0) // 0-8 points
  carsiCoursePoints     Int     @default(0) // 0-12 points
  carsiCECPoints        Int     @default(0) // 0-5 points
  annualCECCredits      Int     @default(0) // Current year CECs earned
  carsiMemberId         String? @db.VarChar(50)

  // Category 4: Industry Association (20 pts max)
  primaryAssocPoints    Int      @default(0) // 0-10 points
  secondaryAssocPoints  Int      @default(0) // 0-10 points
  primaryAssociation    String?  @db.VarChar(100) // RIA, ATFA, ACCA, etc.
  secondaryAssociations String[]

  // Computed totals
  totalPoints      Int                  @default(0)
  partnershipLevel NRPGPartnershipLevel @default(CANDIDATE)

  // Metadata
  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([partnershipLevel], name: "idx_nrpg_partnership_level")
  @@index([totalPoints], name: "idx_nrpg_total_points")
  @@map("nrpg_certification_points")
}

model NRPGOnboardingPhase {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @unique

  // Phase 1: Application & Screening (Days 1-7)
  phase1Status             NRPGPhaseStatus @default(NOT_STARTED)
  phase1StartDate          DateTime?
  phase1CompleteDate       DateTime?
  applicationSubmitted     Boolean         @default(false)
  eligibilityReviewed      Boolean         @default(false)
  backgroundCheckInitiated Boolean         @default(false)

  // Phase 2: Professional Development (Days 8-21)
  phase2Status          NRPGPhaseStatus @default(NOT_STARTED)
  phase2StartDate       DateTime?
  phase2CompleteDate    DateTime?
  carsiOnboarded        Boolean         @default(false)
  associationIntegrated Boolean         @default(false)
  competencyVerified    Boolean         @default(false)

  // Phase 3: Commitment & Integration (Days 22-30)
  phase3Status              NRPGPhaseStatus @default(NOT_STARTED)
  phase3StartDate           DateTime?
  phase3CompleteDate        DateTime?
  standardsTrainingComplete Boolean         @default(false)
  commitmentSigned          Boolean         @default(false)
  commitmentSignedAt        DateTime?
  platformActivated         Boolean         @default(false)

  // Phase 4: Probationary Period (Days 31-120)
  phase4Status             NRPGPhaseStatus @default(NOT_STARTED)
  phase4StartDate          DateTime?
  phase4CompleteDate       DateTime?
  probationEndDate         DateTime?
  performanceReviewScore   Float?
  fullCertificationGranted Boolean         @default(false)

  // Background Check Gateway (mandatory, not points-based)
  criminalCheckStatus BackgroundCheckStatus @default(NOT_INITIATED)
  criminalCheckDate   DateTime?
  criminalCheckRef    String?               @db.VarChar(100)

  financialCheckStatus BackgroundCheckStatus @default(NOT_INITIATED)
  financialCheckDate   DateTime?
  financialCheckRef    String?               @db.VarChar(100)

  professionalCheckStatus BackgroundCheckStatus @default(NOT_INITIATED)
  professionalCheckDate   DateTime?
  professionalCheckRef    String?               @db.VarChar(100)

  insuranceCheckStatus BackgroundCheckStatus @default(NOT_INITIATED)
  insuranceCheckDate   DateTime?
  insuranceCheckRef    String?               @db.VarChar(100)

  // Overall status
  allChecksPass Boolean         @default(false)
  overallStatus NRPGPhaseStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([overallStatus], name: "idx_nrpg_overall_status")
  @@map("nrpg_onboarding_phases")
}

model NRPGTrainingProgress {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String

  // Course identification
  courseId    String @db.VarChar(20) // "CSE" or "WRT"
  moduleId    String @db.VarChar(50) // "CSE-01", "WRT-01", etc.
  moduleName  String @db.VarChar(255)
  moduleOrder Int    @default(0)

  // Progress tracking
  status      ModuleStatus @default(NOT_STARTED)
  progress    Int          @default(0) // 0-100%
  startedAt   DateTime?
  completedAt DateTime?

  // Time tracking
  estimatedMinutes Int @default(0)
  actualMinutes    Int @default(0)

  // Quiz/Assessment
  quizAttempts  Int       @default(0)
  bestQuizScore Int?
  lastQuizScore Int?
  lastQuizAt    DateTime?
  quizPassed    Boolean   @default(false)

  // Content tracking
  contentViewedAt   DateTime?
  exercisesComplete Boolean   @default(false)
  resourcesViewed   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractorId, moduleId])
  @@index([contractorId, courseId], name: "idx_nrpg_training_course")
  @@index([status], name: "idx_nrpg_training_status")
  @@map("nrpg_training_progress")
}

model NRPGCommitment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractorId String @unique

  // Commitment acknowledgements
  professionalStandards Boolean @default(false)
  codeOfConduct         Boolean @default(false)
  qualityAssurance      Boolean @default(false)
  continuingEducation   Boolean @default(false)
  clientProtection      Boolean @default(false)
  industryContribution  Boolean @default(false)

  // Signature
  signatureData   String?   @db.Text // Base64 signature image or typed name
  signatureType   String?   @db.VarChar(20) // "drawn" or "typed"
  signedAt        DateTime?
  signedIpAddress String?   @db.VarChar(45)

  // Witness (optional for formal commitments)
  witnessName  String? @db.VarChar(255)
  witnessEmail String? @db.VarChar(255)

  // PDF generation
  commitmentPdfUrl String?   @db.VarChar(500)
  pdfGeneratedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nrpg_commitments")
}

// ============================================================================
// COMPETITOR ANALYSIS & SEO INTELLIGENCE
// Added for Phase 1 - Designer-Ranking-Branch
// ============================================================================

enum CompetitorCategory {
  RESTORATION_COMPANY // Direct competitors (ServiceMaster, BELFOR, etc.)
  INSURANCE_NETWORK // Insurance company networks (NRMA, Suncorp, etc.)
  CONTRACTOR_MARKETPLACE // Marketplaces (hipages, ServiceSeeking, etc.)
  INDUSTRY_ASSOCIATION // Industry bodies (IICRC, AREMA, etc.)
}

model Competitor {
  id       String             @id @default(cuid())
  domain   String             @unique
  name     String
  category CompetitorCategory
  priority Int                @default(5) // 1-10 scale
  isActive Boolean            @default(true)

  // Business info
  businessModel   String? // "Direct", "Aggregator", "Association"
  targetMarket    String? // "Residential", "Commercial", "Both"
  geographicFocus String[] // States/regions covered

  // Metadata
  contactInfo    Json?
  socialProfiles Json?
  notes          String? @db.Text

  // Relationships
  analyses     CompetitorAnalysis[]
  keywords     CompetitorKeyword[]
  backlinks    Backlink[]
  swotAnalyses SWOTAnalysis[]

  discoveredAt   DateTime  @default(now())
  lastAnalyzedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([lastAnalyzedAt])
  @@map("competitors")
}

model CompetitorAnalysis {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  // Traffic Metrics
  organicTraffic  Int? // Monthly organic visits
  paidTraffic     Int?
  totalKeywords   Int?
  organicKeywords Int?
  paidKeywords    Int?

  // Authority Metrics
  domainRating Float? // Domain authority score
  trustFlow    Float?
  citationFlow Float?

  // Backlink Metrics
  totalBacklinks   Int?
  referringDomains Int?

  // Technical SEO
  pageSpeed     Float? // Google PageSpeed score
  mobileScore   Float?
  coreWebVitals Json? // LCP, FID, CLS

  // Content
  totalPages   Int?
  blogPosts    Int?
  servicePages Int?

  // Raw Data
  analysisDate DateTime @default(now())
  dataSource   String // "SEMRUSH", "DataForSEO", "Combined"
  rawData      Json?    @db.JsonB

  createdAt DateTime @default(now())

  @@index([competitorId])
  @@index([analysisDate])
  @@map("competitor_analyses")
}

model CompetitorKeyword {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  keyword      String
  searchVolume Int? // Monthly searches (Australia)
  difficulty   Float? // 0-100 scale
  cpc          Float? // Cost per click (AUD)

  // Rankings
  position         Int? // Current SERP position
  previousPosition Int?
  url              String? // Ranking URL

