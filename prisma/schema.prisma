enum BlogCategory {
  EMERGENCY_GUIDE // "What to do after flood"
  INSURANCE_CLAIM // "How to file claim"
  PREVENTION // "Prevent mold growth"
  INDUSTRY_INSIGHT // "Contractor empowerment"
  CASE_STUDY // Customer success stories
  RESOURCE // Tools and calculators
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum FAQCategory {
  EMERGENCY_RESPONSE
  PRICING_QUOTES
  INSURANCE_CLAIMS
  SERVICE_SPECIFIC
  CONTRACTOR_NETWORK
  PLATFORM_USAGE
  PREVENTION_TIPS
  SAFETY_HEALTH
}

model BlogPost {
  id       String       @id @default(cuid())
  title    String
  slug     String       @unique
  excerpt  String       @db.Text
  content  String       @db.Text
  category BlogCategory
  tags     String[]

  // SEO
