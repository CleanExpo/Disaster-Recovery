{
  "name": "disaster-recovery",
  "version": "1",
  "description": "Modern SaaS starter for local/trades agencies. Built for SMBs, ready for local dev, and scalable as you grow.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "prisma generate && partytown copylib public/~partytown",
    "copy-partytown": "partytown copylib public/~partytown",
    "build": "prisma generate && partytown copylib public/~partytown && next build",
    "db:deploy": "prisma migrate deploy",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "check:au-english": "node scripts/check-au-english.mjs",
    "format": "prettier --write \"src/lib/validation/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/lib/validation/**/*.{ts,tsx,js,jsx,json}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:scripts": "node --input-type=module -e \"import{readFileSync}from'fs';const p=JSON.parse(readFileSync('./package.json','utf8'));const required=['build','lint','dev','start'];const missing=required.filter(s=>!p.scripts[s]);if(missing.length){console.error('Missing required scripts:',missing);process.exit(1);}console.log('Script governance OK \u2014 all required scripts present:',required.join(', '));\"",
    "analyze": "ANALYZE=true next build",
    "audit:gbp-rating": "tsx scripts/audit-google-places.ts"
  },
  "prisma": {
    "seed": "tsx scripts/core/seed.ts"
  },
