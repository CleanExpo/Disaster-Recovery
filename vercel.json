{
  "framework": "nextjs",
  "installCommand": "npm install --force --legacy-peer-deps --include=dev",
  "buildCommand": "npx prisma@5 generate && node scripts/core/force-build-pages.cjs && node scripts/core/generate-sitemap.cjs && next build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "public": true,
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=8192",
    "NEXT_TELEMETRY_DISABLED": "1",
    "NEXT_PUBLIC_DEMO_MODE": "false"
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=8192",
      "NEXT_TELEMETRY_DISABLED": "1",
      "CI": "false"
    }
  },
  "regions": ["syd1"],
  "github": {
    "enabled": false,
    "silent": true
  },
  "functions": {
    "app/api/cron/reddit-orchestrator/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/reddit-orchestrator",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/reddit-performance",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/gbp-poster",
      "schedule": "0 19 * * 0"
    },
    {
      "path": "/api/cron/expire-job-offers",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/kpi-rollup",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/bond-forfeit",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/pitch-deck/presentation",
      "destination": "/pitch/investor"
    },
    {
      "source": "/pitch-deck",
      "destination": "/pitch"
    }
  ]
}
