# T5Gemma Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
T5GEMMA_MODEL_SIZE=2b
T5GEMMA_DEVICE=cpu
T5GEMMA_MAX_LENGTH=512
T5GEMMA_BATCH_SIZE=8

# Model Paths
T5GEMMA_MODEL_PATH=./models/t5gemma
T5GEMMA_CACHE_DIR=./models/huggingface_cache

# API Configuration
T5GEMMA_API_TIMEOUT=30000
T5GEMMA_API_MAX_RETRIES=3

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Google Vertex AI (optional)
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_REGION=us-central1

# Database Configuration - Connection Pooler
